{
  "name": "recvec-controle-usuarios",
  "version": "6.0.0",
  "description": "Software de controle de usuários RecVec",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.recvec.controleusuarios",
    "productName": "RecVec Controle",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "renderer/**/*",
      "package.json"
    ]
  },
  "license": "ISC"
}
